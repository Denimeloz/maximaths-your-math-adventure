# En-têtes HTTP servis par Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)

/*
  X-Frame-Options: SAMEORIGIN

# Fichiers générés par Vite : leur nom contient un hash qui change à chaque version, on peut les garder un an
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Le service worker doit toujours être revérifié pour que les mises à jour arrivent vite
/sw.js
  Cache-Control: no-cache

# Images et icônes à nom fixe : un jour pour les images, une semaine pour les icônes
/images/*
  Cache-Control: public, max-age=86400

/icon-*
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon*
  Cache-Control: public, max-age=604800
